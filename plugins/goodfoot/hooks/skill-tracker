#!/bin/bash

# skill-tracker: PostToolUse hook that records Skill tool invocations
# Appends each invoked skill name to /tmp/claude_skills_${CLAUDE_PID}.txt

# Read JSON input from stdin
input=$(cat)

# Extract skill name from tool_input.skill using jq
skill=$(echo "$input" | jq -r '.tool_input.skill // empty')

# If no skill name found, output success and exit
if [ -z "$skill" ]; then
    echo '{"continue": true}'
    exit 0
fi

# Source find-claude-pid utility
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
FIND_CLAUDE_PID="${SCRIPT_DIR}/../bin/find-claude-pid"

if [ -f "$FIND_CLAUDE_PID" ]; then
    source "$FIND_CLAUDE_PID"
else
    # Cannot find utility, output success and exit gracefully
    echo '{"continue": true}'
    exit 0
fi

# Get Claude PID
if ! CLAUDE_PID=$(find_claude_pid); then
    : # find_claude_pid returns fallback PID even on failure
fi

# Append skill name to session-scoped file
SKILLS_FILE="/tmp/claude_skills_${CLAUDE_PID}.txt"
echo "$skill" >> "$SKILLS_FILE" 2>/dev/null

# Output minimal JSON response
echo '{"continue": true}'
exit 0
