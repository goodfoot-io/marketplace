#!/bin/bash

# skill-cleanup: SessionEnd hook that cleans up temporary skill tracking files
#
# This hook runs when a session truly ends (NOT during compaction).
# It removes session-scoped temporary files used by the skill reload system.

# Read JSON input from stdin (required for hooks)
cat > /dev/null

# Source the find-claude-pid utility
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../bin/find-claude-pid"

# Get the Claude PID for session-scoped storage
# Use find_claude_pid which respects existing CLAUDE_PID env var
SESSION_PID=$(find_claude_pid)

# Delete temporary files if they exist (rm -f won't error if missing)
rm -f "/tmp/claude_skills_${SESSION_PID}.txt"
rm -f "/tmp/claude_skills_reload_${SESSION_PID}.enabled"

# Output empty JSON
echo '{}'

# Always exit 0 (cleanup hooks should never fail)
exit 0
