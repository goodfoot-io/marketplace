{
  "name": "@goodfoot/test-utilities",
  "version": "1.0.4",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "prettier": "prettier . --write --log-level warn",
    "prettier:files": "prettier --write --log-level warn",
    "eslint": "eslint --cache --fix ./src ./tests",
    "eslint:files": "eslint --cache --fix",
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "lint": "bash -c 'if [ $# -eq 0 ]; then yarn typecheck && yarn eslint && yarn prettier; else yarn typecheck && yarn eslint:files \"$@\" && yarn prettier:files \"$@\"; fi' --",
    "test": "vitest run",
    "release": "bash ../../scripts/release-package.sh test-utilities",
    "release:dry-run": "bash ../../scripts/release-package.sh test-utilities --dry-run"
  },
  "exports": {
    "./*": {
      "import": "./src/*.ts",
      "types": "./src/*.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./*": {
        "import": "./dist/*.js",
        "types": "./types/*.d.ts"
      }
    }
  },
  "devDependencies": {
    "@goodfoot/vitest-cache": "workspace:*",
    "@jest/expect-utils": "^30",
    "@prettier/sync": "^0.6.1",
    "@types/async-exit-hook": "^2.0.2",
    "@types/node": "^26.6.5",
    "@types/uuid": "^11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "jest-matcher-utils": "^30",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "uuid": "^13",
    "vite": "8.3.4",
    "vitest": "patch:vitest@npm%3A5.0.4#~/.yarn/patches/vitest-npm-5.0.4-2ab4bceca5.patch"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "async-exit-hook": "^2.0.1",
    "embedded-postgres": "18.4.0-beta.17",
    "p-queue": "^9.0.1",
    "postgres": "^3.4.7"
  }
}
