{
  "name": "@goodfoot/typescript-metrics",
  "version": "0.0.1",
  "description": "CLI tool for calculating TypeScript codebase metrics: coupling, cycles, complexity, duplication, monorepo health",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs --outdir=../../skills/typescript-metrics/bin/",
    "test": "vitest run",
    "lint": "biome check --write --unsafe --max-diagnostics 500 .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@manypkg/get-packages": "^2.2.2",
    "esbuild": "^0.28.2",
    "glob": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@goodfoot/vitest-cache": "workspace:*",
    "@types/node": "^24",
    "vite": "8.3.4",
    "vitest": "patch:vitest@npm%3A5.0.4#~/.yarn/patches/vitest-npm-5.0.4-2ab4bceca5.patch"
  }
}
