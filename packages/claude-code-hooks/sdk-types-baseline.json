          "type": "{\r\n        /**\r\n         * Active effort level for the current turn (e.g., \"low\", \"medium\", \"high\", \"xhigh\", \"max\"), after any silent downgrade for the selected model. Also exposed to hook commands and Bash as the CLAUDE_EFFORT env var.\r\n         */\r\n        level: string;\r\n    }",
