{
  "name": "@goodfoot/claude-code-hooks",
  "version": "1.2.9",
  "description": "Type-safe Claude Code hooks library with camelCase types and output builders",
  "homepage": "https://github.com/goodfoot-io/marketplace/tree/main/packages/claude-code-hooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfoot-io/marketplace.git",
    "directory": "packages/claude-code-hooks"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./tests ./e2e ./scripts",
    "test": "vitest run",
    "test:types": "vitest run --typecheck",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "release": "bash ../../scripts/release-package.sh claude-code-hooks",
    "release:dry-run": "bash ../../scripts/release-package.sh claude-code-hooks --dry-run",
    "snapshot:sdk-types": "tsx scripts/snapshot-sdk-types.ts",
    "upgrade:deps": "./scripts/upgrade-deps.sh"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "types": "./types/*.d.ts"
    }
  },
  "bin": "./dist/cli.js",
  "publishConfig": {
    "bin": {
      "claude-code-hooks": "./dist/cli.js"
    }
  },
  "dependencies": {
    "esbuild": "^0.24.0",
    "glob": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.86",
    "@biomejs/biome": "2.4.9",
    "@types/node": "^24",
    "ts-morph": "^25.0.0",
    "tsx": "^4.20.3",
    "vitest": "4.0.13"
  }
}
