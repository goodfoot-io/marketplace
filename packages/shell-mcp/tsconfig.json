{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "tests/**/*.ts", "package.json"],
  "exclude": ["node_modules", "dist", "build", "../../node_modules"],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./build/.tsbuildinfo",
    "declarationDir": "./build/types",
    "outDir": "./build/dist",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "references": []
}
