{
  "name": "@goodfoot/shell-mcp",
  "version": "1.0.4",
  "type": "module",
  "sideEffects": false,
  "description": "Remote managed Bash MCP server over Streamable HTTP, reached through an OpenAI Secure MCP Tunnel.",
  "homepage": "https://github.com/goodfoot-io/marketplace/tree/main/packages/shell-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfoot-io/marketplace.git",
    "directory": "packages/shell-mcp"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": "build/dist/src/main.js",
  "files": [
    "build/dist/**",
    "scripts/**",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf build",
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "prepack": "yarn run clean && yarn run build",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./tests",
    "test": "vitest run",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node build/dist/src/main.js",
    "start:openai": "yarn run build && node scripts/start-tunnel.mjs",
    "smoke:local": "yarn run build && node scripts/smoke-local.mjs",
    "smoke:mcp-cli": "node scripts/smoke-mcp-cli.mjs",
    "test:duration": "REMOTE_SHELL_DURATION=1 vitest run tests/duration.opt-in.test.ts",
    "test:soak": "REMOTE_SHELL_SOAK=1 vitest run tests/soak.opt-in.test.ts",
    "release": "bash ../../scripts/release-package.sh shell-mcp",
    "release:dry-run": "bash ../../scripts/release-package.sh shell-mcp --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.0",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
