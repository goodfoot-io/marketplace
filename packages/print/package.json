{
  "name": "@goodfoot/print",
  "version": "0.0.1",
  "description": "CLI tools for code analysis: dependencies, inverse-dependencies, type-analysis",
  "homepage": "https://github.com/goodfoot-io/marketplace/tree/main/packages/print",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfoot-io/marketplace.git",
    "directory": "packages/print"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "types",
    "src"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs --outdir=../../plugins-claude/goodfoot/bin/",
    "test": "vitest run",
    "lint": "biome check --write --unsafe --max-diagnostics 500 .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@manypkg/get-packages": "^2.2.2",
    "dependency-tree": "^11.1.1",
    "esbuild": "^0.24.0",
    "glob": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24",
    "vitest": "^4.0.16"
  }
}
