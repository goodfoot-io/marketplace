{
  "name": "typescript-hooks",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build": "yarn build:claude && yarn build:codex",
    "test": "vitest run",
    "lint": "biome check --write --unsafe --max-diagnostics 500 .",
    "typecheck": "tsc --noEmit",
    "build:claude": "agent-hooks --agent claude-code -i \"src/*.ts\" -o \"../../plugins-claude/typescript-hooks/hooks/hooks.json\"",
    "build:codex": "agent-hooks --agent codex -i \"src/codex/*.ts\" -o \"../../plugins-codex/typescript-hooks/hooks/hooks.json\" --plugin-root",
    "test:artifacts": "yarn build:codex && node test/codex-artifacts.js"
  },
  "dependencies": {
    "@goodfoot/agent-hooks": "workspace:*",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@goodfoot/vitest-cache": "workspace:*",
    "@types/node": "^22.0.0",
    "vite": "8.3.4",
    "vitest": "patch:vitest@npm%3A5.0.4#~/.yarn/patches/vitest-npm-5.0.4-2ab4bceca5.patch"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
