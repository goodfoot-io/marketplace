{
  "name": "typescript-hooks",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build": "agent-hooks --agent claude-code -i \"src/**/*.ts\" -o \"../../plugins-claude/typescript-hooks/hooks/hooks.json\"",
    "test": "vitest run",
    "lint": "biome check --write --unsafe --max-diagnostics 500 .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@goodfoot/agent-hooks": "workspace:*",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
