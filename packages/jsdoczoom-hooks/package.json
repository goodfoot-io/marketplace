{
  "name": "jsdoczoom-hooks",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "claude-code-hooks -i \"src/**/*.ts\" -o \"../../plugins/jsdoczoom/hooks/hooks.json\"",
    "test": "vitest run",
    "lint": "biome check --fix .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@goodfoot/claude-code-hooks": "^1.0.9",
    "jsdoczoom": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
