{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "types"
  ],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./build/.tsbuildinfo",
    "declarationDir": "./types",
    "outDir": "./dist",
    "types": [
      "node"
    ]
  }
}
