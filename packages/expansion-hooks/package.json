{
  "name": "expansion-hooks",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "build": "yarn build:hook && yarn build:bin",
    "build:hook": "agent-hooks --agent claude-code -i \"src/**/*.ts\" -o \"../../plugins-claude/expansion/hooks/hooks.json\"",
    "build:bin": "node esbuild.config.mjs --outdir=../../plugins-claude/expansion/bin/",
    "test": "vitest run",
    "lint": "biome check --write --unsafe --max-diagnostics 500 .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@goodfoot/agent-hooks": "workspace:*",
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
