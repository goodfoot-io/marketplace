{
	"name": "skill-reader",
	"version": "0.1.0",
	"description": "CLI tool for reading and processing Claude Code skills",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20.11.0"
	},
	"files": [
		"dist",
		"types"
	],
	"bin": "./dist/cli.js",
	"publishConfig": {
		"bin": {
			"skill-reader": "./dist/cli.js"
		}
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./types/index.d.ts"
		},
		"./*": {
			"import": "./dist/*.js",
			"types": "./types/*.d.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsc --build tsconfig.build.json",
		"test": "vitest run",
		"lint": "biome check --write --unsafe --max-diagnostics 500 .",
		"release": "bash ../../scripts/release-package.sh skill-reader",
		"release:dry-run": "bash ../../scripts/release-package.sh skill-reader --dry-run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.1",
		"@types/node": "^25.2.3",
		"vitest": "4.0.18"
	}
}
