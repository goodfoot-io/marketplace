{
  "name": "@goodfoot/ts-extra",
  "version": "0.1.0",
  "description": "MCP server for TypeScript analysis including dependencies, types, and complexity metrics",
  "sideEffects": false,
  "type": "module",
  "main": "./build/dist/src/typescript.js",
  "types": "./build/types/src/typescript.d.ts",
  "scripts": {
    "prettier": "prettier . --write --log-level warn",
    "prettier:files": "prettier --write --log-level warn",
    "eslint": "eslint --cache --fix ./src ./tests",
    "eslint:files": "eslint --cache --fix",
    "typecheck": "tsc --noEmit",
    "lint": "bash -c 'if [ $# -eq 0 ]; then yarn typecheck && yarn eslint && yarn prettier; else yarn typecheck && yarn eslint:files \"$@\" && yarn prettier:files \"$@\"; fi' --",
    "build": "tsc --build",
    "test": "yarn build && NODE_OPTIONS=\"${INSPECT:+ --inspect-brk}\" vitest run",
    "release": "bash ../../../scripts/release-package.sh mcp/ts-extra",
    "release:dry-run": "bash ../../../scripts/release-package.sh mcp/ts-extra --dry-run"
  },
  "exports": {
    ".": {
      "import": "./build/dist/src/typescript.js",
      "types": "./build/types/src/typescript.d.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./build/dist/src/typescript.js",
        "types": "./build/types/src/typescript.d.ts"
      }
    }
  },
  "files": [
    "build",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@goodfoot/test-utilities": "workspace:^",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@manypkg/get-packages": "^3.1.0",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "dependency-tree": "^11.2.0",
    "glob": "^11.0.3",
    "ts-morph": "^27.0.2"
  }
}
