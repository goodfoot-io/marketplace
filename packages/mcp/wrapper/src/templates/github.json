{
  "metadata": {
    "name": "GitHub MCP",
    "description": "Official GitHub MCP server with repository and issue management",
    "version": "1.0.0",
    "author": "Anthropic"
  },
  "name": "github",
  "transport": "http",
  "url": "https://api.github.com",
  "headers": {
    "Authorization": "token ${GITHUB_TOKEN}",
    "Accept": "application/vnd.github.v3+json",
    "User-Agent": "MCP-Wrapper/1.0"
  },
  "env": {
    "GITHUB_TOKEN": "${GITHUB_TOKEN}"
  }
}
