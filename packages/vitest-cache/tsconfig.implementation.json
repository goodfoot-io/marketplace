{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "skipLibCheck": false,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "src/**/*.mjs", "scripts/**/*.ts", "vitest.config.ts"],
  "files": [
    "src/test-output-capture.mjs",
    "src/test-output-native.mjs",
    "src/test-output-policy.mjs",
    "src/test-output-reporter.mjs",
    "src/test-output-workerd.mjs",
    "src/test-verbose.mjs",
    "src/test-worker-teardown.mjs",
    "src/vitest-entry.mjs"
  ],
  "exclude": ["scripts/benchmark.ts"]
}
