{
  "name": "@goodfoot/vitest-cache",
  "description": "Content-hash result caching and output policy for Vitest",
  "version": "1.0.4",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "default": "./dist/plan.js"
    },
    "./policy": {
      "types": "./dist/test-output-policy.d.mts",
      "default": "./dist/test-output-policy.mjs"
    },
    "./native": {
      "types": "./dist/test-output-native.d.mts",
      "default": "./dist/test-output-native.mjs"
    },
    "./verbose": {
      "types": "./dist/test-verbose.d.mts",
      "default": "./dist/test-verbose.mjs"
    }
  },
  "bin": {
    "goodfoot-vitest": "dist/vitest-entry.mjs"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings ./src ./test ./smoke ./scripts ./vitest.config.ts ./vitest.smoke.config.ts && jsdoczoom -l '{src,test,smoke,scripts}/**/*.{ts,tsx}'",
    "lint:fix": "biome check --write --unsafe ./src ./test ./smoke ./scripts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.implementation.json",
    "build": "node scripts/build.ts",
    "release": "bash ../../scripts/release-package.sh vitest-cache",
    "release:dry-run": "bash ../../scripts/release-package.sh vitest-cache --dry-run",
    "prepack": "yarn build",
    "test:package": "node scripts/test-package.ts",
    "install": "node scripts/install-native.mjs",
    "test:native-provider": "node scripts/test-native-provider.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/estree": "1.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript/typescript6": "^6.0.2",
    "esbuild": "^0.28.2",
    "jsdoczoom": "2.0.0",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "patch:vitest@npm%3A5.0.4#~/.yarn/patches/vitest-npm-5.0.4-2ab4bceca5.patch"
  },
  "files": [
    "dist",
    "/README.md",
    "OUTPUT.md",
    "scripts/install-native.mjs",
    "native"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
