{
  "$comment": "Bundler-managed plugin registry. Field-by-field contract: packages/plugin-layout-checks/test/registry.ts",
  "lintSuppressionBudget": 3,
  "plugins": [
    {
      "name": "goodfoot",
      "skillsSrc": "skills-src/goodfoot",
      "claudePluginRoot": "plugins-claude/goodfoot",
      "codexPluginRoot": "plugins-codex/goodfoot",
      "opencodePluginRoot": "plugins-opencode/goodfoot",
      "targets": [
        { "platform": "claude-code", "path": "plugins-claude/goodfoot/skills" },
        { "platform": "codex", "path": "plugins-codex/goodfoot/skills" },
        { "platform": "opencode", "path": "plugins-opencode/goodfoot/skills", "opencodeRegistered": false, "note": "goodfoot predates Decision 2: its OpenCode skills are served from the shared ./skills root, which carries the same six skills, so registering this tree as well would duplicate every name." },
        { "platform": "opencode", "path": "skills", "opencodeRegistered": true, "note": "The shared OpenCode root, goodfoot-only by Decision 2. No migrated plugin targets it." }
      ],
      "platformDirs": [],
      "skills": [
        "documentation",
        "instructions",
        "marketing",
        "skillify",
        "typescript-metrics",
        "worktree-cleanup"
      ],
      "skillBin": {
        "typescript-metrics": ["typescript-metrics.mjs"]
      },
      "marketplace": {
        "claude": "goodfoot",
        "codex": "goodfoot"
      },
      "versionSurfaces": {
        "source": "plugins-claude/goodfoot/.claude-plugin/plugin.json",
        "codexManifest": "plugins-codex/goodfoot/.codex-plugin/plugin.json",
        "opencodePackage": "plugins-opencode/goodfoot/package.json"
      },
      "lintSuppressions": []
    },
    {
      "name": "voice",
      "skillsSrc": "skills-src/voice",
      "claudePluginRoot": "plugins/voice",
      "codexPluginRoot": "plugins-codex/voice",
      "opencodePluginRoot": "plugins-opencode/voice",
      "targets": [
        { "platform": "claude-code", "path": "plugins/voice/skills" },
        { "platform": "codex", "path": "plugins-codex/voice/skills" },
        { "platform": "opencode", "path": "plugins-opencode/voice/skills", "opencodeRegistered": true }
      ],
      "platformDirs": [],
      "skills": ["handbook"],
      "marketplace": {
        "claude": "voice",
        "codex": "voice"
      },
      "versionSurfaces": {
        "source": "plugins/voice/.claude-plugin/plugin.json",
        "codexManifest": "plugins-codex/voice/.codex-plugin/plugin.json",
        "opencodePackage": "plugins-opencode/voice/package.json"
      },
      "lintSuppressions": [
        "handbook/SKILL.md:15-15:cross-dialect-reference",
        "handbook/reference/startup-failure.md:7-7:cross-dialect-reference",
        "handbook/reference/startup-failure.md:23-23:cross-dialect-reference"
      ]
    },
    {
