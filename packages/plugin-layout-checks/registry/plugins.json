        { "platform": "claude-code", "path": "plugins/jsdoczoom/skills" },
        { "platform": "codex", "path": "plugins-codex/jsdoczoom/skills" },
        { "platform": "opencode", "path": "plugins-opencode/jsdoczoom/skills", "opencodeRegistered": true }
      ],
      "platformDirs": [],
      "skills": ["style", "cli"],
      "marketplace": {
        "claude": "jsdoczoom",
        "codex": "jsdoczoom"
      },
      "versionSurfaces": {
        "source": "plugins/jsdoczoom/.claude-plugin/plugin.json",
