{
  "name": "@goodfoot/plugin-layout-checks",
  "version": "0.0.1",
  "private": true,
  "description": "Fail-closed structural checks for generated tri-platform plugin layouts, versions, and hooks",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "biome check --write --unsafe --max-diagnostics 500 .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
