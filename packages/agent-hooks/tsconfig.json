{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.d.ts", "tests/**/*.ts", "tests/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "build"],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./build/.tsbuildinfo",
    "declarationDir": "./types",
    "outDir": "./dist",
    "baseUrl": ".",
    "types": ["node"]
  }
}
