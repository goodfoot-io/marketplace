{
  "name": "@goodfoot/agent-hooks",
  "version": "1.0.11",
  "description": "Unified agent hooks library: shared core runtime with per-agent entry points for Claude Code, Codex, and Antigravity",
  "homepage": "https://github.com/goodfoot-io/marketplace/tree/main/packages/agent-hooks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodfoot-io/marketplace.git",
    "directory": "packages/agent-hooks"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.11.0"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./tests ./e2e ./scripts ./vitest.config.ts && node ./scripts/check-stale-imports.mjs",
    "test": "node ./scripts/check-stale-imports.mjs && node ./scripts/check-agent-duplication.mjs && vitest run",
    "release": "bash ../../scripts/release-package.sh agent-hooks",
    "release:dry-run": "bash ../../scripts/release-package.sh agent-hooks --dry-run"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./claude-code": {
      "import": "./dist/agents/claude-code/index.js",
      "types": "./types/agents/claude-code/index.d.ts"
    },
    "./codex": {
      "import": "./dist/agents/codex/index.js",
      "types": "./types/agents/codex/index.d.ts"
    },
    "./opencode": {
      "import": "./dist/agents/opencode/index.js",
      "types": "./types/agents/opencode/index.d.ts"
    },
    "./antigravity": {
      "import": "./dist/agents/antigravity/index.js",
      "types": "./types/agents/antigravity/index.d.ts"
    }
  },
  "bin": "./dist/cli.js",
  "publishConfig": {
    "bin": {
      "agent-hooks": "./dist/cli.js"
    }
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "glob": "^11.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.23"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162",
    "@anthropic-ai/sdk": "^0.133.0",
    "@biomejs/biome": "2.4.16",
    "@goodfoot/vitest-cache": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/plugin": "1.18.23",
    "@types/node": "^26.6.5",
    "tsx": "^4.20.6",
    "vite": "8.3.4",
    "vitest": "patch:vitest@npm%3A5.0.4#~/.yarn/patches/vitest-npm-5.0.4-2ab4bceca5.patch",
    "zod": "^4.6.7"
  }
}
