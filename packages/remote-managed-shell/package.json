{
  "name": "@goodfoot/remote-managed-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "OAuth-protected remote managed Bash MCP server over Streamable HTTP.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --build tsconfig.build.json",
    "lint": "biome check --write --unsafe --max-diagnostics 500 ./src ./tests",
    "test": "vitest run",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node build/dist/src/main.js --mode=public",
    "start:local": "node build/dist/src/main.js --mode=local",
    "start:tunnel": "yarn run build && node scripts/start-tunnel.mjs",
    "smoke:local": "yarn run build && node scripts/smoke-local.mjs",
    "smoke:mcp-cli": "node scripts/smoke-mcp-cli.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "test:public": "node scripts/smoke-public.mjs",
    "test:duration": "REMOTE_SHELL_DURATION=1 vitest run tests/duration.opt-in.test.ts",
    "test:soak": "REMOTE_SHELL_SOAK=1 vitest run tests/soak.opt-in.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^7.0.0",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
