{
	"name": "@goodfoot/claude-code-skill-reader",
	"version": "0.1.0",
	"description": "CLI tool for reading and processing Claude Code skills and commands",
	"homepage": "https://github.com/goodfoot-io/marketplace/tree/main/packages/claude-code-skill-reader",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goodfoot-io/marketplace.git",
		"directory": "packages/claude-code-skill-reader"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20.11.0"
	},
	"files": [
		"dist",
		"types"
	],
	"bin": {
		"claude-code-skill-reader": "dist/cli.js"
	},
	"publishConfig": {
		"bin": {
			"claude-code-skill-reader": "./dist/cli.js"
		}
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./types/index.d.ts"
		},
		"./*": {
			"import": "./dist/*.js",
			"types": "./types/*.d.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsc --build tsconfig.build.json",
		"test": "vitest run",
		"lint": "biome check --write --unsafe --max-diagnostics 500 .",
		"release": "bash ../../scripts/release-package.sh claude-code-skill-reader",
		"release:dry-run": "bash ../../scripts/release-package.sh claude-code-skill-reader --dry-run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.1",
		"@types/node": "^25.2.3",
		"vitest": "4.0.18"
	}
}
