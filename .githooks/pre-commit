#!/bin/bash
# pre-commit dispatcher (fail-closed): runs each sub-script in order; any
# non-zero exit aborts the commit. Sub-scripts must re-stage fixes before gating.
set -e
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
PARTS=(
    pre-commit.plugin-version-bump.sh
    pre-commit.marketplace-sync.sh
)
for part in "${PARTS[@]}"; do
    script="$HOOK_DIR/$part"
    [ -x "$script" ] || continue
    "$script"
done
exit 0
