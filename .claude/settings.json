{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "100000",
    "ENABLE_LSP_TOOL": "1"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "NotebookRead",
      "NotebookEdit"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo -e '\\a'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "jest-mock-prevention@goodfoot": true,
    "typescript-hooks@goodfoot": true,
    "typescript-claude-code-for-web-setup@goodfoot": false,
    "project@goodfoot": true,
    "vscode@goodfoot": true,
    "goodfoot@goodfoot": true,
    "browser@goodfoot": true,
    "gmail@goodfoot": true,
    "github@goodfoot": true,
    "claude-code-hooks@goodfoot": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "goodfoot": {
      "source": {
        "source": "directory",
        "path": "./."
      }
    }
  }
}
