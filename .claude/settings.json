{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "VOICE_SERVER_HTTP_PORT": "5555",
    "VOICE_SERVER_START_BY_DEFAULT": "0",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "250000"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "worktree": {
    "bgIsolation": "none"
  },
  "disableWorkflows": true,
  "disableArtifact": false,
"enabledPlugins": {
    "typescript-hooks@goodfoot": true,
    "typescript-claude-code-for-web-setup@goodfoot": false,
    "project@goodfoot": false,
    "vscode@goodfoot": true,
    "goodfoot@goodfoot": true,
    "jsdoczoom@goodfoot": true,
    "browser@goodfoot": true,
    "gmail@goodfoot": false,
    "github@goodfoot": true,
    "claude-code-hooks@goodfoot": true,
    "code-simplifier@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "voice@goodfoot": true,
    "git-span@git-span": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "goodfoot": {
      "source": {
        "source": "directory",
        "path": "./."
      }
    },
    "git-span": {
      "source": {
        "source": "github",
        "repo": "goodfoot-io/git-span"
      }
    }
  },
  "effortLevel": "medium",
  "askUserQuestionTimeout": "never",
  "autoMemoryEnabled": false
}
