{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "100000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CARDS_CLAUDE_CODE_HOOKS_LOG_FILE": "/workspace/.cards/logs/claude-code-cards-api-hooks.log"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "NotebookRead",
      "NotebookEdit"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-hooks@goodfoot": true,
    "typescript-claude-code-for-web-setup@goodfoot": false,
    "project@goodfoot": false,
    "vscode@goodfoot": true,
    "goodfoot@goodfoot": true,
    "jsdoczoom@goodfoot": true,
    "browser@goodfoot": false,
    "gmail@goodfoot": false,
    "github@goodfoot": true,
    "claude-code-hooks@goodfoot": true,
    "code-simplifier@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": true,
    "cards@cards.management": true
  },
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "goodfoot": {
      "source": {
        "source": "directory",
        "path": "./."
      }
    },
    "cards.management": {
      "source": {
        "source": "directory",
        "path": "/home/node/.vscode-server/data/User/globalStorage/goodfoot.cards/marketplace"
      }
    }
  }
}