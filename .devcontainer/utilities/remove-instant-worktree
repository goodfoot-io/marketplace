#!/bin/bash

# remove-instant-worktree: Safely remove a git worktree created by instant-worktree
#
# This script removes a worktree and its associated branch, outputting the final commit SHA
# before deletion for reference or recovery purposes.
#
# Usage: remove-instant-worktree [-f|--force] <branch-name>
#
# Options:
#   -f, --force    Force removal even if worktree has uncommitted changes
#
# Output: The final commit SHA of the deleted branch (on stdout)
# Exit codes:
#   0 - Success
#   2 - Failure (error details on stderr)

set -e

# Parse arguments
FORCE=false
BRANCH_NAME=""

while [ $# -gt 0 ]; do
    case "$1" in
        -f|--force)
            FORCE=true
            shift
            ;;
        -*)
            printf '%s\n' "Error: Unknown option '$1'" >&2
            printf '%s\n' "Usage: remove-instant-worktree [-f|--force] <branch-name>" >&2
            exit 2
            ;;
        *)
            if [ -z "$BRANCH_NAME" ]; then
                BRANCH_NAME="$1"
            else
                printf '%s\n' "Error: Unexpected argument '$1'" >&2
                printf '%s\n' "Usage: remove-instant-worktree [-f|--force] <branch-name>" >&2
                exit 2
            fi
            shift
            ;;
    esac
done

# Validate branch-name argument is provided
if [ -z "$BRANCH_NAME" ]; then
    printf '%s\n' "Usage: remove-instant-worktree [-f|--force] <branch-name>" >&2
    printf '%s\n' "" >&2
    printf '%s\n' "Safely removes a git worktree and its associated branch." >&2
    printf '%s\n' "Outputs the final commit SHA before deletion." >&2
    printf '%s\n' "" >&2
    printf '%s\n' "Options:" >&2
    printf '%s\n' "  -f, --force    Force removal even if worktree has uncommitted changes" >&2
    exit 2
fi

# Validate branch name format (alphanumeric, hyphens, underscores, slashes for feature branches)
if ! printf '%s\n' "$BRANCH_NAME" | grep -qE '^[a-zA-Z0-9][a-zA-Z0-9/_-]*$'; then
    printf '%s\n' "Error: Invalid branch name format." >&2
    printf '%s\n' "Use alphanumeric characters, hyphens, underscores, and slashes." >&2
    exit 2
fi

# Find workspace root by walking up directory tree looking for .git directory or file
WORKSPACE_ROOT=""
current_dir="$(pwd)"
while [ "$current_dir" != "/" ]; do
    if [ -d "$current_dir/.git" ] || [ -f "$current_dir/.git" ]; then
        WORKSPACE_ROOT="$current_dir"
        break
    fi
    current_dir="$(dirname "$current_dir")"
done

if [ -z "$WORKSPACE_ROOT" ]; then
    printf '%s\n' "Error: Could not find git repository root" >&2
    exit 2
fi

cd "$WORKSPACE_ROOT"

WORKTREE_DIR="${WORKSPACE_ROOT}/.worktrees/${BRANCH_NAME}"

# Check if the branch exists
if ! git branch --list "$BRANCH_NAME" | grep -q .; then
    printf '%s\n' "Error: Branch '$BRANCH_NAME' does not exist" >&2
    exit 2
fi

# Get the final commit SHA before any deletion operations
FINAL_SHA=$(git rev-parse "$BRANCH_NAME" 2>/dev/null)
if [ -z "$FINAL_SHA" ]; then
    printf '%s\n' "Error: Could not determine commit SHA for branch '$BRANCH_NAME'" >&2
    exit 2
fi

# Check if the worktree exists
WORKTREE_EXISTS=false
if git worktree list | grep -q "${WORKTREE_DIR}"; then
    WORKTREE_EXISTS=true
fi

# If the worktree exists, check for uncommitted changes and remove it
if [ "$WORKTREE_EXISTS" = "true" ]; then
    # Check if we're currently in the worktree directory or a subdirectory
    CURRENT_DIR="$(pwd)"
    if [ "$CURRENT_DIR" = "$WORKTREE_DIR" ] || [[ "$CURRENT_DIR" == "$WORKTREE_DIR/"* ]]; then
        printf '%s\n' "Error: Cannot remove worktree while inside it. Please change to a different directory." >&2
        exit 2
    fi

    # Check for uncommitted changes in the worktree
    UNCOMMITTED_FILES=$(git -C "$WORKTREE_DIR" status --porcelain 2>/dev/null || true)
    if [ -n "$UNCOMMITTED_FILES" ] && [ "$FORCE" = "false" ]; then
        printf '%s\n' "Error: Worktree '$BRANCH_NAME' has uncommitted changes:" >&2
        printf '%s\n' "" >&2
        # List the uncommitted files with their status
        printf '%s\n' "$UNCOMMITTED_FILES" | while IFS= read -r line; do
            printf '%s\n' "  $line" >&2
        done
        printf '%s\n' "" >&2
        printf '%s\n' "Use -f or --force to remove anyway:" >&2
        printf '%s\n' "  remove-instant-worktree -f $BRANCH_NAME" >&2
        exit 2
    fi

    # Remove the worktree
    if [ "$FORCE" = "true" ]; then
        # Force removal
        if ! git worktree remove --force "$WORKTREE_DIR" 2>/dev/null; then
            printf '%s\n' "Error: Failed to force remove worktree at '$WORKTREE_DIR'" >&2
            printf '%s\n' "You may need to manually remove it or resolve conflicts." >&2
            exit 2
        fi
    else
        # Normal removal (no uncommitted changes)
        if ! git worktree remove "$WORKTREE_DIR" 2>/dev/null; then
            # This shouldn't happen since we checked for uncommitted changes, but handle it
            printf '%s\n' "Error: Failed to remove worktree at '$WORKTREE_DIR'" >&2
            printf '%s\n' "Try using -f or --force to force removal." >&2
            exit 2
        fi
    fi
fi

# Verify the worktree is actually gone
if [ -d "$WORKTREE_DIR" ]; then
    # Directory still exists but worktree was removed - clean up the directory
    rm -rf "$WORKTREE_DIR" 2>/dev/null || {
        printf '%s\n' "Error: Worktree removed but directory cleanup failed at '$WORKTREE_DIR'" >&2
        exit 2
    }
fi

# Prune any stale worktree references
git worktree prune 2>/dev/null || true

# Check if the branch is checked out elsewhere (in another worktree or main)
BRANCH_CHECKED_OUT=$(git worktree list 2>/dev/null | grep -E "\[$BRANCH_NAME\]" || true)
if [ -n "$BRANCH_CHECKED_OUT" ]; then
    printf '%s\n' "Error: Branch '$BRANCH_NAME' is still checked out in another worktree" >&2
    printf '%s\n' "$BRANCH_CHECKED_OUT" >&2
    exit 2
fi

# Also check if we're on the branch in the main worktree
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$CURRENT_BRANCH" = "$BRANCH_NAME" ]; then
    printf '%s\n' "Error: Cannot delete branch '$BRANCH_NAME' - it is currently checked out" >&2
    exit 2
fi

# Delete the branch
if ! git branch -D "$BRANCH_NAME" >/dev/null 2>&1; then
    printf '%s\n' "Error: Failed to delete branch '$BRANCH_NAME'" >&2
    exit 2
fi

# Output the final commit SHA
printf '%s\n' "$FINAL_SHA"
