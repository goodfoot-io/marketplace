{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT\"/hooks/bin/typescript-check.mjs",
            "timeout": 60000
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PLUGIN_ROOT\"/hooks/bin/eslint-typescript-bypass.mjs",
            "timeout": 10000
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ]
  }
}
